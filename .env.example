# ---------------------------------------------------------------------------
# Copiaza acest fisier in .env.local si completeaza valorile.
# Pe Vercel, aceleasi variabile se seteaza in Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# ===========================================================================
# UNDE AJUNG FORMULARELE
# ===========================================================================
#
#   db           Postgres + PDF generat de noi + email prin Resend.
#                Ai nevoie de DATABASE_URL si RESEND_API_KEY.
#
#   apps-script  Totul pleaca la Google Apps Script: Sheets pentru date,
#                Drive pentru fisa PDF, Gmail pentru email, Virtuagym pentru
#                membri. NU ai nevoie de baza de date, deci site-ul sta
#                gratuit pe Vercel. Vezi scripts/apps-script/Cod.gs.
#
FORMS_BACKEND=db

# URL-ul /exec al Web App-ului (doar pentru FORMS_BACKEND=apps-script)
APPS_SCRIPT_URL=
# Secret comun cu scriptul (Script Properties -> SHARED_TOKEN).
# Fara el, oricine poate posta pe acel URL.
APPS_SCRIPT_TOKEN=
APPS_SCRIPT_TIMEOUT=25

# === Obligatoriu in productie ===

# Cheie pentru sesiunile de admin. Genereaza una cu:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Baza de date Postgres (Neon, Supabase, Railway…).
# Lasa gol local — se foloseste automat un SQLite in folderul proiectului.
# Pe Vercel e obligatoriu DOAR daca FORMS_BACKEND=db sau daca folosesti
# panoul de admin. In modul apps-script nu ai nevoie de el.
DATABASE_URL=

# Primul cont de admin. Dupa ce intri, creeaza un cont real cu:
#   python -m backend.cli create-admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# === Email ===

# Resend — 3.000 emailuri/luna gratis. https://resend.com
RESEND_API_KEY=
# Adresa de expeditor (domeniul trebuie verificat in Resend)
MAIL_FROM=Bluemarin Sport Club <noreply@bluemarin.ro>
# Unde ajung notificarile de formular. Mai multe adrese, separate prin virgula.
MAIL_TO=contact@bluemarin.ro

# Alternativa la Resend: SMTP clasic
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# === Actualizarea site-ului dupa editare din admin ===

# Adresa publica a site-ului
NEXT_PUBLIC_SITE_URL=https://www.bluemarin.ro
SITE_URL=https://www.bluemarin.ro
# Secret comun intre backend si frontend. Genereaza-l la fel ca SECRET_KEY.
REVALIDATE_SECRET=

# === Frontend ===

# De unde citeste Next.js continutul la build. Lasa gol ca sa foloseasca
# fisierele din content/ (merge si fara backend pornit).
# Pe Vercel: https://domeniul-tau.ro/api
CONTENT_API_URL=
# Cat timp tine cache-ul continutului, in secunde.
CONTENT_REVALIDATE=300
# Adresa catre care trimit formularele. Implicit /api, acelasi domeniu.
NEXT_PUBLIC_API_URL=/api

# === Stocarea fisierelor incarcate ===

# "db" (implicit, fara configurare), "s3" (Cloudflare R2 etc.) sau "local" (doar dev)
STORAGE_BACKEND=db
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# === Limite ===

MAX_UPLOAD_MB=8
RATE_LIMIT_PER_HOUR=12

# Necesar doar daca backend-ul sta pe alt domeniu decat site-ul.
ALLOWED_ORIGINS=

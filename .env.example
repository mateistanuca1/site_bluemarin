# ---------------------------------------------------------------------------
# Copiaza acest fisier in .env.local si completeaza valorile.
# Pe Vercel, aceleasi variabile se seteaza in Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# === Obligatoriu in productie ===

# Cheie pentru sesiunile de admin. Genereaza una cu:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Baza de date Postgres (Neon, Supabase, Railway…).
# Lasa gol local — se foloseste automat un SQLite in folderul proiectului.
# Pe Vercel e OBLIGATORIU: fara el, datele se pierd dupa fiecare cerere.
DATABASE_URL=

# Primul cont de admin. Dupa ce intri, creeaza un cont real cu:
#   python -m backend.cli create-admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# === Email ===

# Resend — 3.000 emailuri/luna gratis. https://resend.com
RESEND_API_KEY=
# Adresa de expeditor (domeniul trebuie verificat in Resend)
MAIL_FROM=Bluemarin Sport Club <noreply@bluemarin.ro>
# Unde ajung notificarile de formular. Mai multe adrese, separate prin virgula.
MAIL_TO=contact@bluemarin.ro

# Alternativa la Resend: SMTP clasic
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# === Actualizarea site-ului dupa editare din admin ===

# Adresa publica a site-ului
NEXT_PUBLIC_SITE_URL=https://www.bluemarin.ro
SITE_URL=https://www.bluemarin.ro
# Secret comun intre backend si frontend. Genereaza-l la fel ca SECRET_KEY.
REVALIDATE_SECRET=

# === Frontend ===

# De unde citeste Next.js continutul la build. Lasa gol ca sa foloseasca
# fisierele din content/ (merge si fara backend pornit).
# Pe Vercel: https://domeniul-tau.ro/api
CONTENT_API_URL=
# Cat timp tine cache-ul continutului, in secunde.
CONTENT_REVALIDATE=300
# Adresa catre care trimit formularele. Implicit /api, acelasi domeniu.
NEXT_PUBLIC_API_URL=/api

# DOAR pentru dezvoltare locala: unde ruleaza backend-ul Flask, ca Next.js sa
# poata trimite /api/* catre el. In productie lasa gol — pe Vercel rescrierea
# o face vercel.json. Fara asta, pozele incarcate din admin nu se vad local.
BACKEND_ORIGIN=http://127.0.0.1:5055

# === Google Sheets + Drive (in loc de baza de date) ===

# Cand sunt completate, trimiterile din formulare ajung in foaia de calcul si
# in folderul de Drive, exact ca la scriptul Apps Script de pe site-ul vechi.
# Lasa-le goale ca sa foloseasca baza de date si panoul de admin.
#
# Obtine CLIENT_ID, CLIENT_SECRET si REFRESH_TOKEN ruland o singura data:
#   python3 scripts/google-auth.py
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Din adresa foii:      docs.google.com/spreadsheets/d/<ASTA>/edit
GOOGLE_SHEET_ID=
# Din adresa folderului: drive.google.com/drive/folders/<ASTA>
GOOGLE_DRIVE_FOLDER_ID=

# Alternativa: service account. Merge pentru Sheets, dar pentru Drive are
# nevoie de un Shared Drive — un service account n-are spatiu propriu si
# Google refuza incarcarile cu „storageQuotaExceeded".
GOOGLE_SERVICE_ACCOUNT_JSON=

# === Stocarea fisierelor incarcate ===

# "db" (implicit, fara configurare), "s3" (Cloudflare R2 etc.) sau "local" (doar dev)
STORAGE_BACKEND=db
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# === Virtuagym (optional) ===

# Dupa o inscriere reusita, cursantul e creat automat in softul clubului.
# Fara aceste chei pasul e sarit, iar inscrierea merge mai departe.
VIRTUAGYM_API_KEY=
VIRTUAGYM_CLUB_SECRET=
VIRTUAGYM_CLUB_ID=
VIRTUAGYM_TIMEOUT=15

# === Limite ===

MAX_UPLOAD_MB=8
RATE_LIMIT_PER_HOUR=12

# Necesar doar daca backend-ul sta pe alt domeniu decat site-ul.
ALLOWED_ORIGINS=
